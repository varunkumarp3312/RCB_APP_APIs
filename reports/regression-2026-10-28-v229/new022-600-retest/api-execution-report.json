tn{margin-top:10px}\n.solo-ref{margin-top:12px;font-size:13px;font-weight:600;color:var(--ink-3)}\n.solo-ref b{color:var(--ink-2);font-weight:700;letter-spacing:.04em;-webkit-user-select:all;user-select:all}\n.spin{width:44px;height:44px;border-radius:50%;border:3px solid var(--line-2);\n  border-top-color:var(--gold);animation:paySpin .85s linear infinite}\n@keyframes paySpin{to{transform:rotate(360deg)}}\n\n@media (max-width:360px){\n  .amount-value{font-size:38px}\n  .choice-opt{min-height:112px;padding:12px 10px}\n  .choice-t{font-size:13.5px}\n  .copy{min-width:44px;padding:0 10px}\n  .copy span{display:none}\n}\n</style>\n<noscript><style>.pane.is-off{display:block}.choice{display:none}</style></noscript>\n</head><body>\n<div class=\"shell\">\n<header class=\"brand rise d1\"><span class=\"brand-mark\">RCB</span><span class=\"brand-name\">MATKA</span><span class=\"brand-tag\"><svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3 19.5 5.8v5.4c0 4.3-3 7.7-7.5 9.4-4.5-1.7-7.5-5.1-7.5-9.4V5.8z\"/><path d=\"M8.9 12.2 11.3 14.6 15.4 10\"/></svg>Secure UPI</span></header>\n<section class=\"amount rise d2\"><p class=\"amount-label\">Amount to add</p><p class=\"amount-value\"><span class=\"rupee\">&#8377;</span>600</p><div class=\"amount-meta\"><span class=\"chip\">Order <b>[REDACTED]</b></span><span class=\"chip chip-live\"><i class=\"dot\"></i>Waiting for payment</span></div></section>\n\n<div class=\"choice rise d3\" role=\"tablist\" aria-label=\"Choose how you want to pay\">\n    <button type=\"button\" class=\"choice-opt\" role=\"tab\" data-choice=\"qr\"\n            aria-controls=\"pane-qr\" aria-selected=\"true\">\n        <span class=\"tick\"><svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4.5 12.5 9.5 17.5 19.5 6.8\"/></svg></span>\n        <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><path d=\"M14 14h3v3h-3zM20 14v3M14 20h6\"/></svg>        <span class=\"choice-t\">Scan QR code</span>\n        <span class=\"choice-s\">Scan with any UPI app</span>\n    </button>\n    <button type=\"button\" class=\"choice-opt\" role=\"tab\" data-choice=\"app\"\n            aria-controls=\"pane-app\" aria-selected=\"false\">\n        <span class=\"tick\"><svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4.5 12.5 9.5 17.5 19.5 6.8\"/></svg></span>\n        <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"6\" y=\"2.5\" width=\"12\" height=\"19\" rx=\"2.6\"/><path d=\"M10.5 18.6h3\"/><path d=\"M9.4 8.6h5.2M9.4 12h5.2\"/></svg>        <span class=\"choice-t\">Pay with UPI app</span>\n        <span class=\"choice-s\">Opens the app on this phone</span>\n    </button>\n</div>\n\n<!-- ── (a) SCAN QR ─────────────────────────────────────────────────────── -->\n<section id=\"pane-qr\" role=\"tabpanel\" class=\"pane rise d4\" data-pane=\"qr\">\n    <div class=\"panel\">\n        <div class=\"qr-stage\">\n            <div class=\"qr-frame\">\n                <span class=\"qr-corner tl\"></span><span class=\"qr-corner tr\"></span>\n                <span class=\"qr-corner bl\"></span><span class=\"qr-corner br\"></span>\n                <img src=\"data:image/svg+xml;base64,\"\n                     width=\"240\" height=\"240\" alt=\"UPI QR code for this payment\">\n            </div>\n            <span class=\"qr-amt\">Pay <span>&#8377;600</span></span>\n            <p class=\"qr-cap\">This QR is valid for this one payment only</p>\n        </div>\n\n                <p class=\"sect-label\" style=\"margin-top:16px\">Or pay this UPI ID</p>\n        <div class=\"kv\"><div><p class=\"kv-k\">UPI ID</p><p class=\"kv-v mono\">disanmartlwucb@topay</p></div><button type=\"button\" class=\"copy\" data-copy=\"disanmartlwucb@topay\" aria-label=\"Copy UPI ID\"><svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2.2\"/><path d=\"M15 6.2A2.2 2.2 0 0 0 12.8 4H6.2A2.2 2.2 0 0 0 4 6.2v6.6A2.2 2.2 0 0 0 6.2 15\"/></svg><span>Copy</span></button></div>\n        <div class=\"kv\"><div><p class=\"kv-k\">Payee name</p><p class=\"kv-v mono\">DISAN ESSENTIALS PRIVATE LIMITED</p></div></div>\n            </div>\n\n    <div class=\"panel\">\n        <p class=\"sect-label\">How to pay</p>\n        <ol class=\"steps\"><li><span class=\"step-n\">1</span><div><p class=\"step-t\">Open any UPI app</p><p class=\"step-s\">PhonePe, Google Pay, Paytm, BHIM or your bank app.</p></div></li><li><span class=\"step-n\">2</span><div><p class=\"step-t\">Scan the QR above</p><p class=\"step-s\">Use &quot;Scan QR&quot; — or &quot;Scan from gallery&quot; after you screenshot it.</p></div></li><li><span class=\"step-n\">3</span><div><p class=\"step-t\">Pay exactly ₹600</p><p class=\"step-s\">Your balance is added automatically as soon as the payment clears.</p></div></li></ol>\n    </div>\n</section>\n\n<!-- ── (b) PAY WITH A UPI APP ──────────────────────────────────────────── -->\n<section id=\"pane-app\" role=\"tabpanel\" class=\"pane is-off rise d4\" data-pane=\"app\">\n    <div class=\"panel\">\n        <div class=\"panel-head\">\n            <svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"6\" y=\"2.5\" width=\"12\" height=\"19\" rx=\"2.6\"/><path d=\"M10.5 18.6h3\"/><path d=\"M9.4 8.6h5.2M9.4 12h5.2\"/></svg>            <div>\n                <p class=\"panel-title\">Choose your UPI app</p>\n                <p class=\"panel-sub\">₹600 is filled in for you — just confirm with your UPI PIN.</p>\n            </div>\n        </div>\n\n        <div class=\"apps\"><a class=\"app\" href=\"phonepe://pay?pa=disanmartlwucb@topay&amp;pn=DISAN%20ESSENTIALS%20PRIVATE%20LIMITED&amp;am=600.00&amp;cu=INR&amp;tr=PSKQC3JJF2026102832854\"><span class=\"app-badge\" style=\"--c:#5F259F\">Pe</span><span><span class=\"app-n\">PhonePe</span><span class=\"app-s\">UPI intent</span></span><span class=\"app-go\">Open<svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M5 12h13\"/><path d=\"M12.6 6.2 18.4 12l-5.8 5.8\"/></svg></span></a><a class=\"app\" href=\"tez://upi/pay?pa=disanmartlwucb@topay&amp;pn=DISAN%20ESSENTIALS%20PRIVATE%20LIMITED&amp;am=600.00&amp;cu=INR&amp;tr=PSKQC3JJF2026102832854\"><span class=\"app-badge\" style=\"--c:#0B4DA2\">G</span><span><span class=\"app-n\">Google Pay</span><span class=\"app-s\">UPI intent</span></span><span class=\"app-go\">Open<svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M5 12h13\"/><path d=\"M12.6 6.2 18.4 12l-5.8 5.8\"/></svg></span></a><a class=\"app\" href=\"paytmmp://pay?pa=disanmartlwucb@topay&amp;pn=DISAN%20ESSENTIALS%20PRIVATE%20LIMITED&amp;am=600.00&amp;cu=INR&amp;tr=PSKQC3JJF2026102832854\"><span class=\"app-badge\" style=\"--c:#002970\">Pay</span><span><span class=\"app-n\">Paytm</span><span class=\"app-s\">UPI intent</span></span><span class=\"app-go\">Open<svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M5 12h13\"/><path d=\"M12.6 6.2 18.4 12l-5.8 5.8\"/></svg></span></a><a class=\"app\" href=\"upi://pay?pa=disanmartlwucb@topay&amp;pn=DISAN%20ESSENTIALS%20PRIVATE%20LIMITED&amp;am=600.00&amp;cu=INR&amp;tr=PSKQC3JJF2026102832854\"><span class=\"app-badge gold\">UPI</span><span><span class=\"app-n\">Any other UPI app</span><span class=\"app-s\">BHIM, Amazon Pay, your bank app</span></span><span class=\"app-go\">Open<svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M5 12h13\"/><path d=\"M12.6 6.2 18.4 12l-5.8 5.8\"/></svg></span></a></div>\n\n                <p class=\"sect-label\" style=\"margin-top:16px\">App not listed? Pay this UPI ID</p>\n        <div class=\"kv\"><div><p class=\"kv-k\">UPI ID</p><p class=\"kv-v mono\">disanmartlwucb@topay</p></div><button type=\"button\" class=\"copy\" data-copy=\"disanmartlwucb@topay\" aria-label=\"Copy UPI ID\"><svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2.2\"/><path d=\"M15 6.2A2.2 2.2 0 0 0 12.8 4H6.2A2.2 2.2 0 0 0 4 6.2v6.6A2.2 2.2 0 0 0 6.2 15\"/></svg><span>Copy</span></button></div>\n            </div>\n\n    <div class=\"panel\">\n        <p class=\"sect-label\">How to pay</p>\n        <ol class=\"steps\"><li><span class=\"step-n\">1</span><div><p class=\"step-t\">Tap your app above</p><p class=\"step-s\">It opens with the amount and our UPI ID already filled in.</p></div></li><li><span class=\"step-n\">2</span><div><p class=\"step-t\">Confirm with your UPI PIN</p><p class=\"step-s\">Do not change the amount or the payee.</p></div></li><li><span class=\"step-n\">3</span><div><p class=\"step-t\">Come back to RCB Matka</p><p class=\"step-s\">Your balance is added automatically — this screen closes itself.</p></div></li></ol>\n    </div>\n</section>\n\n<div class=\"note note-warn rise d3\"><svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 3.6 21.2 19.6H2.8z\"/><path d=\"M12 9.6v4.2\"/><path d=\"M12 17.1h.01\"/></svg><div><p class=\"note-t\">Always pay from this screen only</p><p class=\"note-b\">जो पुराना कोड QR History से भुगतान करेगा वो वैध नहीं होगी क्योंकि यहां पर Account Change होता रहता है — a QR or UPI ID saved from an earlier deposit will not be credited.</p></div></div>\n<div class=\"foot rise d5\"><a class=\"btn btn-ghost\" href=\"https://payment.rcbmatka.com/ManualSuccess1.php?lang=en\"><svg class=\"ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 10.4 12 4l8 6.4V19a1.4 1.4 0 0 1-1.4 1.4H5.4A1.4 1.4 0 0 1 4 19z\"/><path d=\"M9.6 20.4v-6h4.8v6\"/></svg><span>Back to home</span></a><p class=\"foot-note\">Do not close the app while the payment is in progress.</p></div>\n</div>\n<script>\n(function () {\n  'use strict';\n\n  /* ── the QR / UPI-app selector ──────────────────────────────────────── */\n  var tabs = [].slice.call(document.querySelectorAll('[data-choice]'));\n  function show(key) {\n    tabs.forEach(function (t) {\n      t.setAttribute('aria-selected', t.getAttribute('data-choice') === key ? 'true' : 'false');\n    });\n    [].forEach.call(document.querySelectorAll('[data-pane]'), function (p) {\n      p.classList.toggle('is-off', p.getAttribute('data-pane') !== key);\n    });\n  }\n  tabs.forEach(function (t) {\n    t.addEventListener('click', function () { show(t.getAttribute('data-choice')); });\n  });\n\n  /* ── copy to clipboard (with an execCommand fallback for old WebViews) ─ */\n  function legacyCopy(text) {\n    var el = document.createElement('input');\n    el.value = text;\n    el.setAttribute('readonly', '');\n    el.style.cssText = 'position:fixed;left:-2000px;top:0;opacity:0';\n    document.body.appendChild(el);\n    el.select();\n    try { el.setSelectionRange(0, text.length); } catch (e) {}\n    var ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) {}\n    document.body.removeChild(el);\n    return ok;\n  }\n  function flash(btn) {\n    var lbl = btn.querySelector('span');\n    var was = lbl ? lbl.textContent : '';\n    btn.classList.add('is-done');\n    if (lbl) { lbl.textContent = \"Copied\"; }\n    setTimeout(function () {\n      btn.classList.remove('is-done');\n      if (lbl) { lbl.textContent = was; }\n    }, 1600);\n  }\n  document.addEventListener('click', function (ev) {\n    var btn = ev.target.closest ? ev.target.closest('[data-copy]') : null;\n    if (!btn) { return; }\n    var text = btn.getAttribute('data-copy') || '';\n    if (!text) { return; }\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(text).then(function () { flash(btn); },\n        function () { legacyCopy(text); flash(btn); });\n    } else {\n      legacyCopy(text);\n      flash(btn);\n    }\n  });\n\n  /* ── screenshot picker: confirm the file was attached ────────────────── */\n  [].forEach.call(document.querySelectorAll('.drop input[type=file]'), function (inp) {\n    inp.addEventListener('change', function () {\n      var tile = inp.closest('.drop');\n      var name = tile.querySelector('.drop-file');\n      var prev = tile.querySelector('.drop-prev');\n      var f = inp.files && inp.files[0];\n      if (!f) {\n        tile.classList.remove('is-set');\n        if (name) { name.textContent = ''; }\n        if (prev) { prev.hidden = true; prev.removeAttribute('src'); }\n        return;\n      }\n      tile.classList.add('is-set');\n      if (name) { name.textContent = f.name; }\n      if (prev && window.URL && URL.createObjectURL) {\n        prev.src = URL.createObjectURL(f);\n        prev.hidden = false;\n      }\n    });\n  });\n\n  /* ── UTR: live 11-13 digit feedback + one-shot submit ────────────────── */\n  var form = document.getElementById('form1');\n  if (form) {\n    var utr  = form.querySelector('input[name=\"utr\"]');\n    var hint = document.getElementById('utrHint');\n    var hintWas = hint ? hint.textContent : '';\n    function utrOk() { return utr && /^\\d{11,13}$/.test(utr.value.trim()); }\n    if (utr) {\n      utr.addEventListener('input', function () {\n        if (!utr.value) {\n          utr.classList.remove('is-bad');\n          if (hint) { hint.classList.remove('is-bad'); hint.textContent = hintWas; }\n          return;\n        }\n        var ok = utrOk();\n        utr.classList.toggle('is-bad', !ok);\n        if (hint) {\n          hint.classList.toggle('is-bad', !ok);\n          hint.textContent = ok ? \"Looks good ✓\"\n            : \"The UTR must be 11 to 13 digits — you have {count}.\".replace('{count}', String(utr.value.replace(/\\D/g, '').length));\n        }\n      });\n    }\n    var sent = false;\n    form.addEventListener('submit', function (ev) {\n      if (sent) { ev.preventDefault(); return; }\n      if (utr && !utrOk()) {\n        ev.preventDefault();\n        utr.classList.add('is-bad');\n        if (hint) {\n          hint.classList.add('is-bad');\n          hint.textContent = \"Enter the 11 to 13 digit UTR \\/ reference number from your payment app.\";\n        }\n        utr.focus();\n        try { utr.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch (e) {}\n        return;\n      }\n      sent = true;\n      form.classList.add('is-busy');\n      var btn = form.querySelector('.btn-primary span');\n      if (btn) { btn.textContent = \"Submitting…\"; }\n    });\n  }\n})();\n</script>\n</body></html>",
